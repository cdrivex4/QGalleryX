
        cancelPendingRequests();
        updateVisibleRange();
      } else {
        qCritical() << "[ViewportCulling] Loading ALL items (Throttled)";
        m_loadAllIndex = 0;
        m_loadAllTimer->start();
      }
    }
  }
  
