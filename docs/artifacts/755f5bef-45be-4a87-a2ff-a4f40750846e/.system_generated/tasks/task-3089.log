      return 4; // RAW/DNG decodes are heavy on CPU
    }
  
    if (ext == "mp4" || ext == "mov" || ext == "mkv" || ext == "avi" ||
>       ext == "wmv" || ext == "heic" || ext == "heif") {
      return 4; // Video thumbnailing / HEVC decoding is heavy on CPU/Video engine
    }
  
    return 1; // Standard JPEGs/PNGs
  }
  
