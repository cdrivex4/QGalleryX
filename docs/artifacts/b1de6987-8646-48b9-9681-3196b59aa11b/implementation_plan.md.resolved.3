### Phase 2: Fix Main Grid Selection

#### GalleryViewScrollBench.qml Fixes

**Keyboard Shortcuts**:
```qml
Keys.onPressed: (event) => {
    if (event.key === Qt.Key_A && event.modifiers & Qt.ControlModifier) {
        imageModel.selectAll()
        event.accepted = true
    }
}
```

**Mouse Handlers**:
```qml
// In GridView delegate
MouseArea {
    onClicked: (mouse) => {
        if (mouse.modifiers & Qt.ControlModifier) {
            imageModel.toggleSelection(index)
        } else if (mouse.modifiers & Qt.ShiftModifier) {
            imageModel.selectRange(lastSelectedIndex, index)
        } else {
            // Normal click - clear and select one
            imageModel.clearSelection()
            imageModel.toggleSelection(index)
        }
    }
}
```

**Drag-to-Select**:
```qml
DragHandler {
    id: dragSelect
    target: null // Don't move anything
    
    property point startPos
    
    onActiveChanged: {
        if (active) {
            startPos = centroid.position
        } else {
            // Calculate grid cells in drag rectangle
            let rect = calculateGridRect(startPos, centroid.position)
            imageModel.selectVisualRect(rect.colMin, rect.colMax, rect.rowMin, rect.rowMax, gridView.columns)
        }
    }
}
```

**Visual Feedback**:
```qml
// In delegate
Rectangle {
    anchors.fill: parent
    border.color: "blue"
    border.width: 3
    color: "transparent"
    visible: model.isSelected
}
```

